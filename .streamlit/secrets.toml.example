# ============================================================
# .streamlit/secrets.toml.example
# Wild Shield Karnataka — Streamlit Cloud Secrets Template
#
# For deployment on Streamlit Cloud:
#   1. Copy this ENTIRE block
#   2. Go to your Streamlit Cloud app → Settings → Secrets
#   3. Paste and fill in your actual values
#
# For local development, use the .env file instead.
# ============================================================

# ── Agent 1 — IBM Watsonx.ai (Risk Assessment Agent) ───────
# Temperature: 0.2 | Model: ibm/granite-4-h-small
WATSONX_API_KEY_1 = "your_ibm_cloud_api_key"
WATSONX_PROJECT_ID_1 = "your_watsonx_project_id"
WATSONX_MODEL_ID_1 = "ibm/granite-4-h-small"
WATSONX_URL_1 = "https://us-south.ml.cloud.ibm.com"

# ── Agent 2 — IBM Watsonx.ai (Safety Advisor Agent) ────────
# Temperature: 0.7 | Same platform as Agent 1
# If using the same IBM account, these can be identical to Agent 1 values.
WATSONX_API_KEY_2 = "your_ibm_cloud_api_key"
WATSONX_PROJECT_ID_2 = "your_watsonx_project_id"
WATSONX_MODEL_ID_2 = "ibm/granite-4-h-small"
WATSONX_URL_2 = "https://us-south.ml.cloud.ibm.com"

# ── MySQL Database (optional — app runs in CSV demo mode without it) ──
# Leave as empty strings to run in demo mode (recommended for hackathon)
DB_HOST = ""
DB_PORT = "3306"
DB_NAME = "wildshield_karnataka"
DB_USER = ""
DB_PASSWORD = ""

# ── Application ─────────────────────────────────────────────
APP_ENV = "production"
APP_DEBUG = "false"
LOG_LEVEL = "INFO"

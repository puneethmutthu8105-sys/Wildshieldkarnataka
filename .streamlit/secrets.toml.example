# ============================================================
# .streamlit/secrets.toml.example
# Wild Shield Karnataka — Streamlit Cloud Secrets Template
#
# For deployment on Streamlit Cloud:
#   1. Copy this content
#   2. Go to your Streamlit Cloud app → Settings → Secrets
#   3. Paste and fill in your actual values
#
# For local development, use the .env file instead.
# ============================================================

# IBM Watsonx.ai — Agent 1 (Risk Assessment Agent)
WATSONX_API_KEY_1 = "your_ibm_watsonx_api_key_here"
WATSONX_PROJECT_ID_1 = "your_watsonx_project_id_here"
WATSONX_MODEL_ID_1 = "ibm/granite-13b-instruct-v2"
WATSONX_URL_1 = "https://us-south.ml.cloud.ibm.com"

# Replicate — Agent 2 (Safety Advisor Agent)
# Model: ibm-granite/granite-4.2-8b
REPLICATE_API_KEY = "your_replicate_api_token_here"
REPLICATE_MODEL_ID = "ibm-granite/granite-4.2-8b"

# MySQL Database (use a cloud-hosted DB for production)
DB_HOST = "your_cloud_db_host"
DB_PORT = "3306"
DB_NAME = "wildshield_karnataka"
DB_USER = "your_db_user"
DB_PASSWORD = "your_db_password"

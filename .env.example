# ============================================================
# WILD SHIELD KARNATAKA — Environment Variables Template
# Copy this file to .env and fill in your real values.
# DO NOT commit .env — it is listed in .gitignore
# ============================================================

# ── Agent 1 — IBM Watsonx.ai (Risk Assessment Agent) ───────
WATSONX_API_KEY_1=REPLACE_WITH_YOUR_IBM_API_KEY
WATSONX_PROJECT_ID_1=REPLACE_WITH_YOUR_PROJECT_ID
WATSONX_MODEL_ID_1=ibm/granite-13b-instruct-v2
WATSONX_URL_1=https://us-south.ml.cloud.ibm.com

# ── Agent 2 — Replicate API — IBM Granite 4.2-8B ───────────
REPLICATE_API_KEY=REPLACE_WITH_YOUR_REPLICATE_TOKEN
REPLICATE_MODEL_ID=ibm-granite/granite-4.2-8b

# ── MySQL Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wildshield_karnataka
DB_USER=root
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

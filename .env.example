# ============================================================
# WILD SHIELD KARNATAKA — Environment Variables Template
# Copy this file to .env and fill in your real values.
# DO NOT commit .env — it is listed in .gitignore
# ============================================================

# ── Agent 1 — IBM Watsonx.ai (Risk Assessment Agent) ───────
# Temperature: 0.2 (analytical — consistent, factual output)
WATSONX_API_KEY_1=REPLACE_WITH_YOUR_IBM_API_KEY
WATSONX_PROJECT_ID_1=REPLACE_WITH_YOUR_WATSONX_PROJECT_ID
WATSONX_MODEL_ID_1=ibm/granite-4-h-small
WATSONX_URL_1=https://us-south.ml.cloud.ibm.com

# ── Agent 2 — IBM Watsonx.ai (Safety Advisor Agent) ────────
# Temperature: 0.7 (natural advisory language)
# Uses same IBM account — configure separate keys for independent billing
# If WATSONX_API_KEY_2 is not set, falls back to WATSONX_API_KEY_1
WATSONX_API_KEY_2=REPLACE_WITH_YOUR_IBM_API_KEY
WATSONX_PROJECT_ID_2=REPLACE_WITH_YOUR_WATSONX_PROJECT_ID
WATSONX_MODEL_ID_2=ibm/granite-4-h-small
WATSONX_URL_2=https://us-south.ml.cloud.ibm.com

# IMPORTANT — Your Watsonx.ai project must be associated with a
# Watson Machine Learning (WML) service instance.
# Without this, inference calls return HTTP 403.
# To link: IBM Cloud → Watsonx.ai → Project → Manage → Services & integrations → Add WML service

# ── MySQL Database (optional — app works without it) ────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wildshield_karnataka
DB_USER=root
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
